# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Banco (Neon Postgres) -------------------------------------------------
# Painel do Neon > Connection string (use a "pooled" em produção/Vercel).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- LLM (Google Gemini; camada gratuita em https://aistudio.google.com) ----
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo do agent. Trocável sem mudar código (ver README: "Escolha do modelo").
LLM_MODEL=gemini-3.5-flash

# --- Sessão ----------------------------------------------------------------
# Segredo para assinar o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=

# --- Serviço de chamados simulado -----------------------------------------
# Probabilidade (0 a 1) de o serviço legado ficar indisponível numa chamada.
# Use 0 em testes automatizados e ~0.1 para demonstrar o tratamento de erro.
TICKETING_FAILURE_RATE=0

# --- Proteção de custo / abuso --------------------------------------------
# Limite de mensagens do funcionário por conversa (regra do PRD: 30).
CHAT_MESSAGE_LIMIT=30
