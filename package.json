{
  "name": "nexo-assist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.mts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.126",
    "@mastra/core": "^1.86.0",
    "@neondatabase/serverless": "^1.2.1",
    "ai": "^7.0.181",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
